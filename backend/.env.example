# SQLite (zero setup, for development - default)
DATABASE_URL=sqlite+aiosqlite:///./grc.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/grc_db

SECRET_KEY=grc-secret-key-change-in-production-abc123xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ENVIRONMENT=development
DEBUG=true
